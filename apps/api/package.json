{
  "name": "@telemax/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@telemax/core": "workspace:*",
    "@telemax/generator-engine": "workspace:*",
    "@telemax/generator-wordpress": "workspace:*",
    "@telemax/workflow": "workspace:*",
    "@fastify/cors": "10.0.2",
    "@fastify/swagger": "9.4.2",
    "@fastify/swagger-ui": "5.2.1",
    "better-sqlite3": "11.8.1",
    "fastify": "5.2.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "eslint": "9.18.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "3.0.4",
    "@types/better-sqlite3": "7.6.12"
  }
}
