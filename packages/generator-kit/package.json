{
  "name": "@telemax/generator-kit",
  "version": "0.1.0",
  "description": "Abstract SDK for building generators on top of Telemax AI Factory. Defines the Generator contract and a BaseGenerator that plugs into the kernel. Depends on @telemax/core; contains no concrete generators.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@telemax/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
