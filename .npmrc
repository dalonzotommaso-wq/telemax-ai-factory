# -----------------------------------------------------------------------------
# pnpm configuration.
#
# strict-peer-dependencies : fail fast on unmet peer ranges instead of silently
#                            resolving a possibly-incompatible version.
# auto-install-peers       : install declared peer dependencies automatically.
# dedupe-peer-dependents   : hoist compatible peers to reduce duplication.
# save-exact               : pin exact versions on install for reproducible builds.
# engine-strict            : refuse to install under an unsupported Node engine.
# -----------------------------------------------------------------------------
strict-peer-dependencies=true
auto-install-peers=true
dedupe-peer-dependents=true
save-exact=true
engine-strict=true
